/* Mesh-Pulse dashboard: dense, peer-first network tooling. */

DashboardScreen {
    layout: grid;
    grid-size: 2 4;
    grid-columns: 3fr 2fr;
    grid-rows: 3 3fr 2fr 2;
    background: $surface;
}

#header {
    column-span: 2;
    height: 3;
    background: $surface-darken-1;
    color: $text;
    padding: 0 2;
    border-bottom: solid $accent;
    text-style: bold;
}

#peer-panel,
#health-panel,
#transfer-panel,
#log-panel {
    background: $surface;
    border: solid $panel;
    overflow-y: auto;
}

#peer-panel {
    margin: 1 0 0 1;
    border: solid $accent;
}

#health-panel {
    margin: 1 1 0 0;
}

#transfer-panel {
    margin: 0 0 0 1;
}

#log-panel {
    margin: 0 1 0 0;
}

#footer {
    column-span: 2;
    height: 2;
    background: $surface-darken-1;
    color: $text-muted;
    padding: 0 2;
    border-top: solid $panel;
}

DashboardScreen.compact {
    grid-size: 1 6;
    grid-columns: 1fr;
    grid-rows: 3 11 12 10 10 2;
    overflow-y: auto;
}

DashboardScreen.compact #header,
DashboardScreen.compact #footer {
    column-span: 1;
}

DashboardScreen.compact #peer-panel,
DashboardScreen.compact #health-panel,
DashboardScreen.compact #transfer-panel,
DashboardScreen.compact #log-panel {
    margin: 0 1;
}
